//// Untyped RPC primitives for generated code and explicit interoperability.
////
//// A caller supplies a method name and decoder independently of the server.
//// This module does not provide the shared API guarantee. Application code
//// should use the client generated by starflame_rpc_kit instead.

import gleam/dynamic.{type Dynamic}
import gleam/dynamic/decode.{type Decoder}
import gleam/javascript/promise.{type Promise}
import gleam/result
import starflame/client
import starflame/plain.{type Plain}

pub fn call(
  stub: client.Stub,
  method: String,
  args: List(Plain),
  decoder: Decoder(a),
) -> Promise(Result(a, client.RpcError)) {
  use reply <- promise.map(do_call(stub, method, args))
  use value <- result.try(reply)
  decode.run(value, decoder) |> result.map_error(client.Decode)
}

/// Keeps the Cap'n Web stub as it is; its method types are not checked here.
pub fn stub_decoder() -> Decoder(client.Stub) {
  decode.dynamic |> decode.map(unsafe_stub)
}

/// Encodes a callback with a caller-supplied decoder. Generated clients derive
/// this decoder from the server API's callback argument.
pub fn callback(arguments: Decoder(a), callback: fn(a) -> Nil) -> Plain {
  variadic(fn(values: Dynamic) {
    case decode.run(values, arguments) {
      Ok(values) -> callback(values)
      Error(_) -> Nil
    }
  })
}

@external(javascript, "./client_ffi.mjs", "call")
fn do_call(
  stub: client.Stub,
  method: String,
  args: List(Plain),
) -> Promise(Result(Dynamic, client.RpcError))

@external(javascript, "./plain_ffi.mjs", "identity")
fn unsafe_stub(value: Dynamic) -> client.Stub

@external(javascript, "./client_ffi.mjs", "variadic")
fn variadic(callback: fn(Dynamic) -> Nil) -> Plain
