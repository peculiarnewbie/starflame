{
  "name": "@starflame/example-photos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "rpc": "gleam run -m starflame_rpc_kit -- generate",
    "codecs": "gleam run -m starflame_rpc_kit -- codecs",
    "test": "gleam run -m starflame_rpc_kit -- check && gleam build && node test/run.mjs",
    "typecheck": "gleam run -m starflame_rpc_kit -- check && gleam build && cf workers types && tsc --noEmit"
