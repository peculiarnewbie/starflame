    player_name: fast_decode.get(value, "player_name"),
    hands: fast_decode.list(
      fast_decode.get(value, "hands"),
      hand_result_from_plain,
    ),
    insurance_payout: fast_decode.get(value, "insurance_payout"),
    net_chips: fast_decode.get(value, "net_chips"),
  )
}

fn round_result_fallback() -> decode.Decoder(shared.RoundResult) {
  use player_id <- decode.field("player_id", decode.string)
  use player_name <- decode.field("player_name", decode.string)
  use hands <- decode.field("hands", decode.list(hand_result_decoder()))
  use insurance_payout <- decode.field("insurance_payout", decode.int)
  use net_chips <- decode.field("net_chips", decode.int)
  decode.success(shared.RoundResult(
    player_id:,
    player_name:,
    hands:,
    insurance_payout:,
    net_chips:,
  ))
}

