// GameError -------------------------------------------------------------------

pub fn game_error_to_plain(value: shared.GameError) -> plain.Plain {
  case value {
    shared.PlayerNotFound(player_id:) ->
      plain.tagged("PlayerNotFound", [#("player_id", plain.string(player_id))])
    shared.TableFull(limit:) ->
      plain.tagged("TableFull", [#("limit", plain.int(limit))])
    shared.NotYourTurn -> plain.tagged("NotYourTurn", [])
    shared.WrongPhase(phase:) ->
      plain.tagged("WrongPhase", [#("phase", phase_to_plain(phase))])
    shared.AlreadyBet -> plain.tagged("AlreadyBet", [])
    shared.SittingOut -> plain.tagged("SittingOut", [])
    shared.AlreadyDecided -> plain.tagged("AlreadyDecided", [])
    shared.HandIsDone -> plain.tagged("HandIsDone", [])
    shared.CannotSplit -> plain.tagged("CannotSplit", [])
    shared.CannotDouble -> plain.tagged("CannotDouble", [])
    shared.CannotStartRound -> plain.tagged("CannotStartRound", [])
    shared.EmptyName -> plain.tagged("EmptyName", [])
    shared.NameTooLong(limit:) ->
      plain.tagged("NameTooLong", [#("limit", plain.int(limit))])
  }
}

pub fn game_error_decoder() -> decode.Decoder(shared.GameError) {
  fast_decode.kind_decoder(
    game_error_kind,
    game_error_from_plain,
    game_error_fallback,
  )
}

/// Builds a value that matched `game_error_kind`.
pub fn game_error_from_plain(value: dynamic.Dynamic) -> shared.GameError {
  case fast_decode.tag(value) {
    "PlayerNotFound" ->
      shared.PlayerNotFound(player_id: fast_decode.get(value, "player_id"))
    "TableFull" -> shared.TableFull(limit: fast_decode.get(value, "limit"))
    "NotYourTurn" -> shared.NotYourTurn
    "WrongPhase" ->
      shared.WrongPhase(
        phase: phase_from_plain(fast_decode.get(value, "phase")),
      )
    "AlreadyBet" -> shared.AlreadyBet
    "SittingOut" -> shared.SittingOut
    "AlreadyDecided" -> shared.AlreadyDecided
    "HandIsDone" -> shared.HandIsDone
    "CannotSplit" -> shared.CannotSplit
    "CannotDouble" -> shared.CannotDouble
    "CannotStartRound" -> shared.CannotStartRound
    "EmptyName" -> shared.EmptyName
    _ -> shared.NameTooLong(limit: fast_decode.get(value, "limit"))
  }
}

fn game_error_fallback() -> decode.Decoder(shared.GameError) {
  use tag <- decode.field("$", decode.string)
  case tag {
    "PlayerNotFound" -> {
      use player_id <- decode.field("player_id", decode.string)
      decode.success(shared.PlayerNotFound(player_id:))
    }
    "TableFull" -> {
      use limit <- decode.field("limit", decode.int)
      decode.success(shared.TableFull(limit:))
    }
    "NotYourTurn" -> decode.success(shared.NotYourTurn)
    "WrongPhase" -> {
      use phase <- decode.field("phase", phase_decoder())
      decode.success(shared.WrongPhase(phase:))
    }
    "AlreadyBet" -> decode.success(shared.AlreadyBet)
    "SittingOut" -> decode.success(shared.SittingOut)
    "AlreadyDecided" -> decode.success(shared.AlreadyDecided)
    "HandIsDone" -> decode.success(shared.HandIsDone)
    "CannotSplit" -> decode.success(shared.CannotSplit)
    "CannotDouble" -> decode.success(shared.CannotDouble)
    "CannotStartRound" -> decode.success(shared.CannotStartRound)
    "EmptyName" -> decode.success(shared.EmptyName)
    "NameTooLong" -> {
      use limit <- decode.field("limit", decode.int)
      decode.success(shared.NameTooLong(limit:))
    }
    _ -> decode.failure(shared.NotYourTurn, "GameError")
  }
}
