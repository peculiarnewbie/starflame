{
  "name": "@starflame/example-notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "rpc": "gleam run -m starflame_rpc_kit -- generate",
    "db": "gleam run -m db_kit --",
    "test": "gleam run -m starflame_rpc_kit -- check && gleam run -m db_kit -- check && gleam build && node test/run.mjs",
    "typecheck": "gleam run -m starflame_rpc_kit -- check && gleam build && cf workers types && tsc --noEmit",
    "migrate:local": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@openauthjs/openauth": "0.4.3",
    "capnweb": "0.12.0",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "cf": "1.0.0-beta.10",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "@starflame/vite": "workspace:*"
  }
}
