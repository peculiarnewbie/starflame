{
  "name": "starflame-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @starflame/runtime --filter @starflame/db-kit --filter @starflame/rpc-kit --filter @starflame/openauth --filter @starflame/example-blog --filter @starflame/example-notes --filter @starflame/example-blackjack --filter @starflame/example-photos --filter @starflame/example-chat --filter @starflame/example-canvas test && pnpm --filter @starflame/example-rpc exp",
    "dev": "pnpm --filter @starflame/example-todo dev",
    "dev:blackjack": "pnpm --filter @starflame/example-blackjack dev",
    "smoke": "pnpm --filter @starflame/example-todo smoke",
    "test:compare": "pnpm --filter @starflame/example-todo test:compare",
    "deploy:todo": "pnpm --filter @starflame/example-todo run deploy",
    "dev:photos": "pnpm --filter @starflame/example-photos dev",
    "dev:chat": "pnpm --filter @starflame/example-chat dev",
    "dev:canvas": "pnpm --filter @starflame/example-canvas dev"
  }
}
